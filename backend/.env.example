# =============================================================================
# Agentic RAG Research Assistant — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- LLM Provider (pick one) ------------------------------------------------

# Option A: OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Option B: Google Gemini (free tier via Google AI Studio)
GOOGLE_API_KEY=your_google_api_key_here

# Which LLM provider to use: "openai" or "google"
LLM_PROVIDER=google

# Model names (defaults shown — override if needed)
OPENAI_MODEL=gpt-4o-mini
GOOGLE_MODEL=gemini-2.0-flash

# --- Embedding Model --------------------------------------------------------

# Which embedding provider to use: "openai" or "huggingface"
# "huggingface" uses all-MiniLM-L6-v2 locally (free, no API key needed)
EMBEDDING_PROVIDER=huggingface
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HUGGINGFACE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- LangSmith Observability (optional but recommended) ---------------------

LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=agentic-rag-assistant

# --- Application Settings ---------------------------------------------------

# ChromaDB persistence directory (relative to backend/)
CHROMA_PERSIST_DIR=./chroma_db

# Maximum file upload size in bytes (default: 20MB)
MAX_UPLOAD_SIZE=20971520

# Retrieval top-k (number of chunks to retrieve)
RETRIEVAL_TOP_K=6

# Chunking parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50
